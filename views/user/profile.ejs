




<%- include("../../views/partials/user/header") %>
<style>
 .card-green {
   background-color: #ADD8E6;
 }
 .main {
   padding: 30px 0;
 }
 .dashboard-menu {
   background-color: #cce3e6;
   border-radius: 10px;
   padding: 15px;
   box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
 }
 .dashboard-menu .nav-link {
   font-weight: bold;
   color: #30683c;
   box-shadow: 0 4px 10px rgba(123, 131, 112, 0.3), 0 4px 20px rgba(0, 191, 255, 0.2);
   transition: box-shadow 0.3s ease;
 }
 .dashboard-menu .nav-link:hover {
   color: #00bfff;
   box-shadow: 0 4px 15px rgba(173, 255, 47, 0.5), 0 6px 25px rgba(0, 191, 255, 0.4);
 }
 .card {
   border-radius: 10px;
   box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
   margin-bottom: 20px;
 }
 .card-header {
   background-color: #487379;
   color: white;
   border-radius: 10px 10px 0 0;
 }
 .btn-success {
   background-color: #577194;
   border-color: #6bb87d;
 }
 .btn-success:hover {
   background-color: #506955;
 }
 .form-group {
   margin-bottom: 15px;
 }
 .required {
   color: red;
 }
 @media (max-width: 768px) {
   .dashboard-menu {
     padding: 10px;
   }
   .card {
     margin-bottom: 15px;
   }
 }
 .page-header.breadcrumb-wrap {
   background-color: #eee2e9;
   padding: 15px 0;
 }
 .breadcrumb {
   display: flex;
   align-items: center;
   font-family: 'Arial', sans-serif;
   font-size: 16px;
   color: #121311;
 }
 .breadcrumb a {
   color: #007bff;
   text-decoration: none;
   position: relative;
   margin: 0 5px;
 }
 .breadcrumb a:hover {
   color: #0056b3;
 }
 .breadcrumb span {
   margin: 0 5px;
   color: #999;
 }
 .breadcrumb a::after {
   content: '';
   position: absolute;
   width: 100%;
   height: 2px;
   background: #6e6e3a;
   left: 0;
   bottom: -2px;
   transform: scaleX(0);
   transition: transform 0.3s ease;
 }
 .breadcrumb a:hover::after {
   transform: scaleX(1);
 }
 .pagination {
   display: flex;
   justify-content: center;
   margin-top: 20px;
 }
 .pagination a {
   padding: 8px 16px;
   margin: 0 5px;
   text-decoration: none;
   color: #007bff;
   border: 1px solid #ddd;
   border-radius: 4px;
 }
 .pagination a.active {
   background-color: #007bff;
   color: white;
   border-color: #007bff;
 }
 .pagination a:hover {
   background-color: #ddd;
 }
 .pagination span.disabled {
   padding: 8px 16px;
   color: #ddd;
   cursor: not-allowed;
   border: 1px solid #ddd;
   border-radius: 4px;
 }
</style>

<main class="main" style="margin-top: 60px;">
 <div class="page-header breadcrumb-wrap mb-3">
   <div class="container">
     <div class="breadcrumb">
       <a href="#" rel="nofollow">Home</a>
       <span></span> Profile <span></span> Account
     </div>
   </div>
 </div>
 <section class="pt-10 pb-10">
   <div class="container">
     <div class="row">
       <div class="col-lg-10 m-auto">
         <div class="row">
           <div class="col-md-4">
             <div class="dashboard-menu" style="margin-left: -10vw;width:25vw;">
               <ul class="nav flex-column" role="tablist">
                 <li class="nav-item">
                   <a class="nav-link active" id="dashboard-tab" data-bs-toggle="tab" href="#dashboard" role="tab" aria-controls="dashboard" aria-selected="false">
                     <i class="fi-rs-settings-sliders mr-10"></i>Dashboard
                   </a>
                 </li>
                 <li class="nav-item">
                   <a class="nav-link" id="address-tab" data-bs-toggle="tab" href="#address" role="tab" aria-controls="address" aria-selected="true">
                     <i class="fi-rs-marker mr-10"></i>My Address
                   </a>
                 </li>
                 <li class="nav-item">
                   <a class="nav-link" id="orders-tab" data-bs-toggle="tab" href="#orders" role="tab" aria-controls="orders" aria-selected="false">
                     <i class="fi-rs-shopping-bag mr-10"></i>Orders
                   </a>
                 </li>
                 <li class="nav-item">
                   <a class="nav-link" id="track-orders-tab" data-bs-toggle="tab" href="#track-orders" role="tab" aria-controls="track-orders" aria-selected="false">
                     <i class="fi-rs-shopping-cart-check mr-10"></i>Wallet Status
                   </a>
                 </li>
                 <li class="nav-item">
                   <a class="nav-link" id="wallet-history-tab" data-bs-toggle="tab" href="#wallet-history" role="tab" aria-controls="wallet-history" aria-selected="false">
                     <i class="fi-rs-shopping-cart-check mr-10"></i>Wallet History
                   </a>
                 </li>
                 <li class="nav-item">
                   <form action="/logout" method="POST" class="d-inline d-md-block ms-md-3">
                     <button type="submit" class="btn btn-sm w-100 w-md-auto" style="background-color: #577194;color:white;">Logout</button>
                   </form>
                 </li>
               </ul>
             </div>
           </div>
           <div class="col-md-8">
             <div class="tab-content dashboard-content">
               <div class="tab-pane fade show active" id="dashboard" role="tabpanel" aria-labelledby="dashboard-tab">
                 <div class="card card-green">
                   <div class="card-header">
                     <h5 class="mb-0 text-center">User Profile</h5>
                   </div>
                   <div class="card-body text-center">
                     <h5 class="card-title"><%=user.name%></h5>
                     <p class="card-text">
                       <strong>Phone:</strong> 
                       <% if (user.phone) { %>
                           <%= user.phone %>
                       <% } else if (userAddress && userAddress.address[0] && userAddress.address[0].phone) { %>
                           <%= userAddress.address[0].phone %>
                       <% } else { %>
                           Please provide phone number
                       <% } %>
                     </p>
                     <p class="card-text">
                       <strong>Email:</strong><%=user.email%>
                     </p>
                     <a href="/change-email" class="btn btn-sm btn-success ml-2">Change Email</a>
                     <a href="/change-password" class="btn btn-sm btn-success">Change Password</a>
                   </div>
                 </div>
               </div>
               <div class="tab-pane fade" id="address" role="tabpanel" aria-labelledby="address-tab">
                 <div class="row" id="address-list">
                   <%if(userAddress){%>
                     <%userAddress.address.forEach((address)=>{%>
                     <div class="col-lg-6" data-address-id="<%=address._id%>">
                       <div class="card mb-3 mb-lg-0">
                         <div class="card-header">
                           <h5 class="mb-0"><%=address.addressType%></h5>
                         </div>
                         <div class="card-body">
                           <address>
                             <%=address.name%> <br>
                             <%=address.city%> <br>
                             <%=address.landMark%> <br>
                             <%=address.state%> <br>
                           </address>
                           <p><%=address.pincode%></p>
                           <p><%=address.phone%></p>
                           <p><%=address.altPhone%></p>
                           <div class="d-flex justify-content-between">
                             <a href="/editAddress?id=<%=address._id%>" class="btn-small">Edit</a>
                             <a href="javascript:void(0);" class="btn-small delete-btn" data-id="<%= address._id %>">Delete</a>
                           </div>
                         </div>
                       </div>
                     </div>
                     <%})%><%}else{%>
                     <div class="col-lg-6">
                       <div class="card mb-3 mb-lg-0">
                         <div class="card-header">
                           <h5 class="mb-0"></h5>
                         </div>
                         <div class="card-body">
                           <address>No address</address>
                         </div>
                       </div>
                     </div>
                     <%}%>
                     <div>
                       <a href="/addAddress">
                         <button class="btn btn-primary w-70">Add address</button>
                       </a>
                     </div>
                 </div>
               </div>
               <div class="tab-pane fade" id="orders" role="tabpanel" aria-labelledby="orders-tab">
                 <div class="card" style="width: 70vw;margin-left: -10vw;">
                   <div class="card-header">
                     <h5 class="mb-0">Your Orders</h5>
                   </div>
                   <div class="card-body">
                     <div class="table-responsive">
                       <table class="table" id="ordersTable">
                         <thead>
                           <tr>
                             <th>Order Id</th>
                             <th>Product Name</th>
                             <th>Status</th>
                             <th>Total</th>
                             <th>Actions</th>
                             <th>Actions</th>
                             <th>Payment</th>
                           </tr>
                         </thead>
                         <tbody id="ordersBody">
                           <% if (orders.length > 0) { %>
                             <% orders.forEach(order => { %>
                               <tr>
                                 <td><%= order.orderId %></td>
                                 <td>
                                   <% order.orderedItems.forEach((item, index) => { %>
                                     <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 5px;">
                                       <span><%= item.name %></span>
                                       <img src="/uploads/re-image/<%= item.image %>" alt="<%= item.name %>" style="height: 50px; width: 50px; object-fit: cover;">
                                     </div>
                                     <% if (index < order.orderedItems.length - 1) { %>
                                       <br>
                                     <% } %>
                                   <% }); %>
                                 </td>
                                 <td class="badge bg-warning text-dark badge-status" style="margin-top: 2px;"><%= order.status %></td>
                                 <td>₹<%= order.finalAmount %></td>
                                 <td>
                                   <% if (order.status === "Pending" || order.status === "Shipped") { %>
                                     <button class="btn btn-danger btn-sm" onclick="confirmCancellation('<%= order._id %>')">Cancel</button>
                                   <% } %>
                                   <% if (order.status === "Delivered") { %>
                                     <button class="btn btn-success btn-sm" onclick="confirmReturn('<%= order._id %>')">Return</button>
                                   <% } else if (order.status !== "Pending" && order.status !== "Shipped") { %>
                                     <span class="text-muted" style="display: block; margin-top: 5px;"><%= order.status %></span>
                                   <% } %>
                                 </td>
                                 <td>
                                   <a href="/viewOrder/<%= order._id %>" class="btn btn-primary btn-sm">View</a>
                                 </td>
                                 <td>
                                   <% if(order.paymentStatus === "notCompleted") { %>
                                     <button 
                                       type="button" 
                                       class="btn btn-success btn-sm" 
                                       onclick="submitRazorpayForm('<%= order.address %>', '<%= order.paymentMethod %>', '<%= order.finalAmount %>', '<%= order._id %>')"
                                     >
                                       Pay Now
                                     </button>
                                   <% } else { %>
                                     <%= order.paymentStatus %>
                                   <% } %>
                                 </td>
                               </tr>
                             <% }) %>
                           <% } else { %>
                             <tr>
                               <td colspan="7" class="text-center">No orders found</td>
                             </tr>
                           <% } %>
                         </tbody>
                       </table>
                     </div>
                     <% if (totalOrderPages >= 1) { %>
                       <nav>
                         <ul class="pagination" id="orderPagination">
                           <li class="page-item <%= currentOrderPage === 1 ? 'disabled' : '' %>">
                             <a class="page-link" href="javascript:void(0)" onclick="fetchOrders('<%= currentOrderPage - 1 %>', '<%= orderLimit %>')">Previous</a>
                           </li>
                           <% for (let i = 1; i <= totalOrderPages; i++) { %>
                             <li class="page-item <%= currentOrderPage === i ? 'active' : '' %>">
                               <a class="page-link" href="javascript:void(0)" onclick="fetchOrders('<%= i %>', '<%= orderLimit %>')"><%= i %></a>
                             </li>
                           <% } %>
                           <li class="page-item <%= currentOrderPage === totalOrderPages ? 'disabled' : '' %>">
                             <a class="page-link" href="javascript:void(0)" onclick="fetchOrders('<%= currentOrderPage + 1 %>', '<%= orderLimit %>')">Next</a>
                           </li>
                         </ul>
                       </nav>
                     <% } %>
                   </div>
                 </div>
               </div>
               <div class="tab-pane fade" id="track-orders" role="tabpanel" aria-labelledby="track-orders-tab">
                 <div class="card">
                   <div class="card-header">
                     <h5 class="mb-0">Wallet</h5>
                   </div>
                   <div class="card-body contact-from-area">
                     <div class="row">
                       <div class="col-lg-8 mx-auto text-center mt-90">
                         <form>
                           <div class="form-group">
                             <label for="walletAmount" class="h4">Amount</label>
                             <div class="h3">₹<%= wallet.balance%></div>
                           </div>
                           <button type="button" class="btn btn-success">Add Money</button>
                         </form>
                       </div>
                     </div>
                   </div>
                 </div>
               </div>
               <div class="tab-pane fade" id="wallet-history" role="tabpanel" aria-labelledby="wallet-history-tab">
                 <div class="card">
                   <div class="card-header">
                     <h5 class="mb-0">Wallet History</h5>
                   </div>
                   <div class="card-body">
                     <div class="table-responsive">
                       <table class="table">
                         <thead>
                           <tr>
                             <th>Date</th>
                             <th>Status</th>
                             <th>Amount</th>
                             <th>Description</th>
                           </tr>
                         </thead>
                         <tbody id="walletHistory">
                           <% wallet.transactionHistory.forEach(transaction => { %>
                             <tr>
                               <td><%= new Date(transaction.transactionDate).toLocaleString() %></td>
                               <td><%= transaction.transactionType %></td>
                               <td>₹<%= transaction.transactionAmount %></td>
                               <td><%= transaction.description %></td>
                             </tr>
                           <% }) %>
                         </tbody>
                       </table>
                       <nav>
                         <ul class="pagination" id="walletPagination">
                           <li class="page-item <%= currentWalletPage === 1 ? 'disabled' : '' %>">
                             <a class="page-link" href="javascript:void(0)" onclick="fetchWalletHistory('<%= currentWalletPage - 1 %>', '<%= walletLimit %>')">Previous</a>
                           </li>
                           <% for (let i = 1; i <= totalWalletPages; i++) { %>
                             <li class="page-item <%= currentWalletPage === i ? 'active' : '' %>">
                               <a class="page-link" href="javascript:void(0)" onclick="fetchWalletHistory('<%= i %>', '<%= walletLimit %>')"><%= i %></a>
                             </li>
                           <% } %>
                           <li class="page-item <%= currentWalletPage === totalWalletPages ? 'disabled' : '' %>">
                             <a class="page-link" href="javascript:void(0)" onclick="fetchWalletHistory('<%= currentWalletPage + 1 %>', '<%= walletLimit %>')">Next</a>
                           </li>
                         </ul>
                       </nav>
                     </div>
                   </div>
                 </div>
               </div>
             </div>
           </div>
         </div>
       </div>
     </div>
   </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<%- include("../../views/partials/user/footer") %>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.delete-btn').forEach(button => {
    button.addEventListener('click', function () {
      const addressId = this.getAttribute('data-id');
      Swal.fire({
        title: 'Are you sure?',
        text: 'Do you really want to delete this address?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Yes, delete it!',
        cancelButtonText: 'Cancel'
      }).then((result) => {
        if (result.isConfirmed) {
          deleteAddress(addressId);
        }
      });
    });
  });
});

function deleteAddress(addressId) {
  fetch(`/deleteAddress?id=${addressId}`, {
    method: 'DELETE',
    headers: { 'Content-Type': 'application/json' }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      Swal.fire({
        icon: 'success',
        title: 'Address Deleted',
        text: 'The address has been deleted successfully.'
      }).then(() => {
        // Remove the address from the DOM
        const addressElement = document.querySelector(`div[data-address-id="${addressId}"]`);
        if (addressElement) {
          addressElement.remove();
        }
        // Check if there are any addresses left
        const addressList = document.getElementById('address-list');
        const addressCards = addressList.querySelectorAll('div[data-address-id]');
        if (addressCards.length === 0) {
          const noAddressDiv = document.createElement('div');
          noAddressDiv.className = 'col-lg-6';
          noAddressDiv.innerHTML = `
            <div class="card mb-3 mb-lg-0">
              <div class="card-header">
                <h5 class="mb-0"></h5>
              </div>
              <div class="card-body">
                <address>No address</address>
              </div>
            </div>
          `;
          addressList.insertBefore(noAddressDiv, addressList.querySelector('div:last-child'));
        }
      });
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Deletion Failed',
        text: data.message || 'Failed to delete the address.'
      });
    }
  })
  .catch(error => {
    console.error('Error deleting address:', error);
    Swal.fire({
      icon: 'error',
      title: 'Error',
      text: 'Error deleting the address.'
    });
  });
}

function submitRazorpayForm(addressId, paymentMethod, amount, orderId) {
  console.log("orderId 1 : ", orderId);
  fetch('/createRazorpayOrder', {
    method: 'POST',
    body: JSON.stringify({ amount: amount, addressId: addressId, paymentMethod: 'razorpay' }),
    headers: { 'Content-Type': 'application/json' }
  })
  .then(response => response.json())
  .then(data => {
    const options = {
      key: data.razorpayKey,
      amount: amount * 100,
      currency: "INR",
      name: "Your Company",
      description: "Test Transaction",
      order_id: data.orderId,
      handler: function (response) {
        verifyPayment(response, addressId, amount, orderId);
      },
      prefill: {
        name: "Sandeep",
        email: "sandeep@gmail.com",
        contact: "9847242891"
      },
      modal: {
        ondismiss: function () {
          Swal.fire({
            icon: 'error',
            title: 'Payment Cancelled',
            text: 'Your payment process is cancelled.'
          });
        }
      }
    };
    const rzp1 = new Razorpay(options);
    rzp1.open();
  })
  .catch(error => console.error('Error:', error));
}

function verifyPayment(response, selectedAddress, totalAmount, orderId) {
  console.log("orderId 2 : ", orderId);
  const paymentDetails = {
    razorpay_payment_id: response.razorpay_payment_id,
    razorpay_order_id: response.razorpay_order_id,
    razorpay_signature: response.razorpay_signature,
    totalPrice: totalAmount,
    addressId: selectedAddress,
    orderId: orderId
  };
  fetch('/verifyRazorpayPayment', {
    method: 'POST',
    body: JSON.stringify(paymentDetails),
    headers: { 'Content-Type': 'application/json' }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      Swal.fire({
        icon: 'success',
        title: 'Payment Verified',
        text: 'Payment verified and order placed!'
      }).then(() => {
        fetchOrders('<%= currentOrderPage %>', '<%= orderLimit %>');
      });
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Payment Failed',
        text: 'Payment verification failed. Please try again.'
      });
    }
  })
  .catch(error => {
    console.error('Error:', error);
    Swal.fire({
      icon: 'error',
      title: 'Error',
      text: 'Error verifying payment.'
    });
  });
}

function confirmCancellation(orderId) {
  Swal.fire({
    title: 'Are you sure?',
    text: "You want to cancel this order!",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#3085d6',
    cancelButtonColor: '#d33',
    confirmButtonText: 'Yes, cancel it!'
  }).then((result) => {
    if (result.isConfirmed) {
      cancelOrder(orderId);
    }
  });
}

function confirmReturn(orderId) {
  Swal.fire({
    title: 'Are you sure?',
    text: "You want to return this order!",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#3085d6',
    cancelButtonColor: '#d33',
    confirmButtonText: 'Yes, return it!'
  }).then((result) => {
    if (result.isConfirmed) {
      returnOrder(orderId);
    }
  });
}

function cancelOrder(orderId) {
  console.log(`Sending cancel request for order: ${orderId}`);
  fetch(`/cancelOrder/${orderId}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' }
  })
  .then(response => response.json())
  .then(data => {
    console.log(`Cancel response:`, data);
    if (data.success) {
      Swal.fire({
        icon: 'success',
        title: 'Order Cancelled',
        text: 'The order has been cancelled successfully.'
      }).then(() => {
        fetchOrders('<%= currentOrderPage %>', '<%= orderLimit %>');
      });
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Cancellation Failed',
        text: data.message || 'Failed to cancel the order.'
      });
    }
  })
  .catch(error => {
    console.error('Error cancelling order:', error);
    Swal.fire({
      icon: 'error',
      title: 'Error',
      text: 'Error cancelling the order.'
    });
  });
}

function returnOrder(orderId) {
  fetch(`/returnOrder/${orderId}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      Swal.fire({
        icon: 'success',
        title: 'Order Returned',
        text: 'The order has been returned successfully.'
      }).then(() => {
        fetchOrders('<%= currentOrderPage %>', '<%= orderLimit %>');
      });
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Return Failed',
        text: data.message || 'Failed to return the order.'
      });
    }
  })
  .catch(error => {
    console.error('Error returning order:', error);
    Swal.fire({
      icon: 'error',
      title: 'Error',
      text: 'Error returning the order.'
    });
  });
}

function fetchOrders(page, limit) {
  console.log(`Fetching orders for page ${page}, limit ${limit}`);
  const url = new URL(window.location.href);
  const searchParams = new URLSearchParams(url.search);
  searchParams.set('orderPage', page);
  searchParams.set('limit', limit);
  history.pushState({}, '', `${url.pathname}?${searchParams.toString()}`);

  fetch(`/getOrders?orderPage=${page}&limit=${limit}`, {
    method: 'GET',
    headers: { 'Content-Type': 'application/json' }
  })
  .then(response => response.json())
  .then(data => {
    console.log(`Fetch orders response:`, data);
    if (data.success) {
      updateOrdersTable(data.orders, data.currentOrderPage, data.totalOrderPages, data.orderLimit);
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: data.message || 'Failed to load orders.'
      });
    }
  })
  .catch(error => {
    console.error('Error fetching orders:', error);
    Swal.fire({
      icon: 'error',
      title: 'Error',
      text: 'Error fetching orders.'
    });
  });
}

function updateOrdersTable(orders, currentOrderPage, totalOrderPages, orderLimit) {
  const ordersBody = document.getElementById('ordersBody');
  const orderPagination = document.getElementById('orderPagination');

  if (orders.length === 0) {
    ordersBody.innerHTML = '<tr><td colspan="7" class="text-center">No orders found</td></tr>';
    orderPagination.innerHTML = '';
    return;
  }

  ordersBody.innerHTML = orders.map(order => `
    <tr>
      <td>${order.orderId}</td>
      <td>
        ${order.orderedItems.map((item, index) => `
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 5px;">
            <span>${item.name}</span>
            <img src="/Uploads/re-image/${item.image}" alt="${item.name}" style="height: 50px; width: 50px; object-fit: cover;">
          </div>
          ${index < order.orderedItems.length - 1 ? '<br>' : ''}
        `).join('')}
      </td>
      <td class="badge bg-warning text-dark badge-status" style="margin-top: 2px;">${order.status}</td>
      <td>₹${order.finalAmount}</td>
      <td>
        ${order.status === "Pending" || order.status === "Shipped" ? 
          `<button class="btn btn-danger btn-sm" onclick="confirmCancellation('${order._id}')">Cancel</button>` : 
          order.status === "Delivered" ? 
          `<button class="btn btn-success btn-sm" onclick="confirmReturn('${order._id}')">Return</button>` : 
          `<span class="text-muted" style="display: block; margin-top: 5px;">${order.status}</span>`}
      </td>
      <td>
        <a href="/viewOrder/${order._id}" class="btn btn-primary btn-sm">View</a>
      </td>
      <td>
        ${order.paymentStatus === "notCompleted" ? 
          `<button type="button" class="btn btn-success btn-sm" onclick="submitRazorpayForm('${order.address}', '${order.paymentMethod}', '${order.finalAmount}', '${order._id}')">Pay Now</button>` : 
          order.paymentStatus}
      </td>
    </tr>
  `).join('');

  orderPagination.innerHTML = `
    <li class="page-item ${currentOrderPage === 1 ? 'disabled' : ''}">
      <a class="page-link" href="javascript:void(0)" onclick="fetchOrders(${currentOrderPage - 1}, ${orderLimit})">Previous</a>
    </li>
    ${Array.from({ length: totalOrderPages }, (_, i) => i + 1).map(i => `
      <li class="page-item ${currentOrderPage === i ? 'active' : ''}">
        <a class="page-link" href="javascript:void(0)" onclick="fetchOrders(${i}, ${orderLimit})">${i}</a>
      </li>
    `).join('')}
    <li class="page-item ${currentOrderPage === totalOrderPages ? 'disabled' : ''}">
      <a class="page-link" href="javascript:void(0)" onclick="fetchOrders(${currentOrderPage + 1}, ${orderLimit})">Next</a>
    </li>
  `;
}

function fetchWalletHistory(page, limit = 5) {
  console.log(`Fetching wallet history for page ${page}, limit ${limit}`);
  const url = new URL(window.location.href);
  const searchParams = new URLSearchParams(url.search);
  searchParams.set('walletPage', page);
  searchParams.set('walletLimit', limit);
  history.pushState({}, '', `${url.pathname}?${searchParams.toString()}`);

  fetch(`/getWalletHistory?walletPage=${page}&walletLimit=${limit}`, {
    method: 'GET',
    headers: { 'Content-Type': 'application/json' }
  })
  .then(response => response.json())
  .then(data => {
    console.log(`Fetch wallet history response:`, data);
    if (data.success) {
      updateWalletHistoryTable(data.transactions, data.currentWalletPage, data.totalWalletPages, data.walletLimit);
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: data.message || 'Failed to load wallet history.'
      });
    }
  })
  .catch(error => {
    console.error('Error fetching wallet history:', error);
    Swal.fire({
      icon: 'error',
      title: 'Error',
      text: 'Error fetching wallet history.'
    });
  });
}

function updateWalletHistoryTable(transactions, currentWalletPage, totalWalletPages, walletLimit) {
  const walletHistory = document.getElementById('walletHistory');
  const walletPagination = document.getElementById('walletPagination');

  if (transactions.length === 0) {
    walletHistory.innerHTML = '<tr><td colspan="4" class="text-center">No wallet history found</td></tr>';
    walletPagination.innerHTML = '';
    return;
  }

  walletHistory.innerHTML = transactions.map(transaction => `
    <tr>
      <td>${new Date(transaction.transactionDate).toLocaleString()}</td>
      <td>${transaction.transactionType}</td>
      <td>₹${transaction.transactionAmount}</td>
      <td>${transaction.description}</td>
    </tr>
  `).join('');

  walletPagination.innerHTML = `
    <li class="page-item ${currentWalletPage === 1 ? 'disabled' : ''}">
      <a class="page-link" href="javascript:void(0)" onclick="fetchWalletHistory(${currentWalletPage - 1}, ${walletLimit})">Previous</a>
    </li>
    ${Array.from({ length: totalWalletPages }, (_, i) => i + 1).map(i => `
      <li class="page-item ${currentWalletPage === i ? 'active' : ''}">
        <a class="page-link" href="javascript:void(0)" onclick="fetchWalletHistory(${i}, ${walletLimit})">${i}</a>
      </li>
    `).join('')}
    <li class="page-item ${currentWalletPage === totalWalletPages ? 'disabled' : ''}">
      <a class="page-link" href="javascript:void(0)" onclick="fetchWalletHistory(${currentWalletPage + 1}, ${walletLimit})">Next</a>
    </li>
  `;
}
</script>

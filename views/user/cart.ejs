


<%- include("../../views/partials/user/header") %>

<link rel="stylesheet" type="text/css" href="css/util.css">
<link rel="stylesheet" type="text/css" href="css/main.css">
<link rel="stylesheet" href="./user-assets/css/maind134.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
  .btn-loading::after {
    content: '';
    display: inline-block;
    width: 12px;
    height: 12px;
    border: 2px solid #fff;
    border-radius: 50%;
    border-top-color: transparent;
    animation: spin 1s linear infinite;
    margin-left: 8px;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<main class="main" style="margin-top: 150px;">
    <h2 style="margin-left: 45vw;">CART</h2>
    <div class="page-header breadcrumb-wrap">
        <div class="container">
            <div class="breadcrumb">
                <a href="/" rel="nofollow">Home</a>
                <span></span> <a href="/shop">Shop</a>
                <span></span> My Cart
            </div>
        </div>
    </div>

    <section class="mt-50 mb-50">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="table-responsive">
                        <table class="table shopping-summery text-center clean">
                            <thead>
                                <tr class="main-heading">
                                    <th scope="col">Image</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Price</th>
                                    <th scope="col">Quantity</th>
                                    <th scope="col">Total Price</th>
                                    <th scope="col">Delete</th>
                                </tr>
                            </thead>
                            <tbody id="cartTableBody">
                                <% if (cart && cart.length > 0) { %>
                                    <% cart.forEach((item) => { %>
                                        <tr data-product-id="<%= item.productId._id %>" data-size="<%= item.size %>">
                                            <td class="image product-thumbnail">
                                                <img src="/Uploads/re-image/<%= item.productId.productImage[0] %>" alt="<%= item.productId.productName %>" width="50" height="50">
                                            </td>
                                            <td class="product-des product-name">
                                                <h5 class="product-name">
                                                    <a href="#">
                                                        <%= item.productId.productName %>
                                                    </a>
                                                </h5>
                                                <p class="font-xs" style="color: #088178;">
                                                    <strong>Size: <%= item.size %></strong>
                                                </p>
                                                <p class="font-xs" style="color: #088178;">
                                                    <strong>Max Stock: <%= item.maxStock %></strong>
                                                </p>
                                            </td>
                                            <td class="price" data-title="Price">₹<span><%= item.productId.salePrice %></span></td>
                                            <td class="text-center" data-title="Quantity">
                                                <div class="input-group quantity-group">
                                                    <button class="btn btn-sm btn-decrement" onclick="changeQuantity('<%= item.productId._id %>', '<%= item.size %>', -1)">-</button>
                                                    <input type="number" min="1" max="<%= Math.min(10, item.maxStock) %>" class="form-control quantity-input" data-product-id="<%= item.productId._id %>" data-size="<%= item.size %>" value="<%= item.quantity %>" readonly>
                                                    <button class="btn btn-sm btn-increment" onclick="changeQuantity('<%= item.productId._id %>', '<%= item.size %>', 1)">+</button>
                                                </div>
                                            </td>
                                            <td class="text-center" data-title="Total">₹<span class="item-total"><%= item.quantity * item.productId.salePrice %></span></td>
                                            <td class="action" data-title="Remove">
                                                <a class="btn btn-sm delete-product" href="#" data-product-id="<%= item.productId._id %>" data-size="<%= item.size %>" onclick="confirmRemove('<%= item.productId._id %>', '<%= item.size %>')">
                                                    <i class="fi-rs-trash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <p class="lead mb-4">No items found in Cart</p>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <% if (cart && cart.length > 0) { %>
                <div class="total-price-container text-right mt-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="font-weight-bold">Total Price:</h4>
                        <h4 class="font-weight-bold" style="font-size: 24px; color: #088178;" id="cartTotalPrice">₹<%= totalPrice.toFixed(2) %></h4>
                    </div>
                    <hr>
                    <a class="btn btn-success btn-lg" href="/checkout" style="width: 200px;">
                        <i class="bi bi-credit-card"></i> Proceed to Checkout
                    </a>
                </div>
            <% } %>
        </div>
    </section>
</main>

<script>
async function loadCart() {
    console.log('loadCart called'); // Debug
    try {
        const response = await fetch('/cart/data', {
            method: 'GET',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        console.log('loadCart response:', data); // Debug
        if (data.status) {
            const tbody = document.getElementById('cartTableBody');
            const totalPriceElement = document.getElementById('cartTotalPrice');
            const totalPriceContainer = document.querySelector('.total-price-container');

            if (data.cart && data.cart.length > 0) {
                tbody.innerHTML = data.cart.map(item => `
                    <tr data-product-id="${item.productId._id}" data-size="${item.size}">
                        <td class="image product-thumbnail">
                            <img src="/Uploads/re-image/${item.productId.productImage[0]}" alt="${item.productId.productName}" width="50" height="50">
                        </td>
                        <td class="product-des product-name">
                            <h5 class="product-name">
                                <a href="#">${item.productId.productName}</a>
                            </h5>
                            <p class="font-xs" style="color: #088178;">
                                <strong>Size: ${item.size}</strong>
                            </p>
                            <p class="font-xs" style="color: #088178;">
                                <strong>Max Stock: ${item.maxStock}</strong>
                            </p>
                        </td>
                        <td class="price" data-title="Price">₹<span>${item.productId.salePrice}</span></td>
                        <td class="text-center" data-title="Quantity">
                            <div class="input-group quantity-group">
                                <button class="btn btn-sm btn-decrement" onclick="changeQuantity('${item.productId._id}', '${item.size}', -1)">-</button>
                                <input type="number" min="1" max="${Math.min(10, item.maxStock)}" class="form-control quantity-input" data-product-id="${item.productId._id}" data-size="${item.size}" value="${item.quantity}" readonly>
                                <button class="btn btn-sm btn-increment" onclick="changeQuantity('${item.productId._id}', '${item.size}', 1)">+</button>
                            </div>
                        </td>
                        <td class="text-center" data-title="Total">₹<span class="item-total">${item.quantity * item.productId.salePrice}</span></td>
                        <td class="action" data-title="Remove">
                            <a class="btn btn-sm delete-product" href="#" data-product-id="${item.productId._id}" data-size="${item.size}" onclick="confirmRemove('${item.productId._id}', '${item.size}')">
                                <i class="fi-rs-trash"></i>
                            </a>
                        </td>
                    </tr>
                `).join('');
                if (totalPriceContainer) {
                    totalPriceContainer.style.display = 'block';
                    totalPriceElement.textContent = `₹${data.totalPrice.toFixed(2)}`;
                }
            } else {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="text-center">
                            <p class="lead mb-4">No items found in Cart</p>
                        </td>
                    </tr>`;
                if (totalPriceContainer) {
                    totalPriceContainer.style.display = 'none';
                }
            }
        } else {
            Swal.fire('Error', data.message || 'Error loading cart', 'error');
        }
    } catch (error) {
        console.error('Error loading cart:', error);
        Swal.fire('Error', `Error loading cart: ${error.message}`, 'error');
    }
}

function confirmRemove(productId, size) {
    console.log(`confirmRemove called with productId: ${productId}, size: ${size}`); // Debug
    Swal.fire({
        title: 'Are you sure?',
        text: 'Do you want to remove this product from your cart?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Yes, remove it!',
        cancelButtonText: 'Cancel'
    }).then((result) => {
        if (result.isConfirmed) {
            const deleteButton = document.querySelector(`.delete-product[data-product-id="${productId}"][data-size="${size}"]`);
            if (!deleteButton) {
                console.error('Delete button not found for productId:', productId, 'size:', size);
                Swal.fire('Error', 'Delete button not found. Please try again.', 'error');
                return;
            }
            deleteButton.classList.add('btn-loading');
            deleteButton.style.pointerEvents = 'none';

            fetch(`/removeFromCart/${productId}`, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ size: size })
            })
            .then(response => response.json())
            .then(data => {
                console.log('Remove product response:', data); // Debug
                if (data.status) {
                    Swal.fire('Removed!', 'Product removed from cart', 'success').then(() => {
                        loadCart();
                    });
                } else {
                    Swal.fire('Error', data.message || 'Failed to remove product', 'error');
                }
            })
            .catch(error => {
                console.error('Error removing product:', error);
                Swal.fire('Error', `An error occurred: ${error.message}`, 'error');
            })
            .finally(() => {
                deleteButton.classList.remove('btn-loading');
                deleteButton.style.pointerEvents = 'auto';
            });
        }
    });
}

function changeQuantity(productId, size, change) {
    console.log(`changeQuantity called with productId: ${productId}, size: ${size}, change: ${change}`); // Debug
    const quantityInput = document.querySelector(`.quantity-input[data-product-id="${productId}"][data-size="${size}"]`);
    let currentQuantity = parseInt(quantityInput.value);
    const maxStock = parseInt(quantityInput.getAttribute('max'));

    let newQuantity = currentQuantity + change;

    if (newQuantity < 1) {
        Swal.fire('Error', 'Quantity cannot be less than 1', 'error');
        return;
    } else if (newQuantity > 10 || newQuantity > maxStock) {
        Swal.fire('Error', `Quantity cannot exceed ${Math.min(10, maxStock)}`, 'error');
        return;
    }

    const decrementBtn = document.querySelector(`.btn-decrement[onclick*="changeQuantity('${productId}', '${size}', -1)"]`);
    const incrementBtn = document.querySelector(`.btn-increment[onclick*="changeQuantity('${productId}', '${size}', 1)"]`);
    decrementBtn.classList.add('btn-loading');
    incrementBtn.classList.add('btn-loading');
    decrementBtn.disabled = true;
    incrementBtn.disabled = true;

    fetch(`/updateCartQuantity/${productId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ size: size, quantity: newQuantity })
    })
    .then(response => response.json())
    .then(data => {
        console.log('Update quantity response:', data); 
        if (data.status) {
            Swal.fire('Updated!', 'Quantity updated', 'success').then(() => {
                loadCart();
            });
        } else {
            Swal.fire('Error', data.message || 'Failed to update quantity', 'error');
            quantityInput.value = currentQuantity; 
        }
    })
    .catch(error => {
        console.error('Error updating quantity:', error);
        Swal.fire('Error', `An error occurred: ${error.message}`, 'error');
        quantityInput.value = currentQuantity; 
    })
    .finally(() => {
        decrementBtn.classList.remove('btn-loading');
        incrementBtn.classList.remove('btn-loading');
        decrementBtn.disabled = false;
        incrementBtn.disabled = false;
    });
}

document.addEventListener('DOMContentLoaded', () => {
    loadCart(); 
});
</script>

<%- include("../../views/partials/user/footer") %>

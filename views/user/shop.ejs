<div class="bg0 m-t-23 p-b-140" style="margin-top: 120px;">
	<div class="container">
		<div class="flex-w flex-sb-m p-b-52">
			<div class="panel-search w-full p-t-10 p-b-15">
				<div class="dis-flex p-l-15">
					<form id="searchForm" class="search-form" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
						<button class="size-113 flex-c-m fs-16 cl2 hov-cl1 trans-04 search-button" type="submit" style="margin-right: 10px;">
							<i class="zmdi zmdi-search"></i>
						</button>
						<input class="mtext-107 cl2 size-114 plh2 p-r-15 search-input" type="text" name="query" value="<%= searchQuery %>" placeholder="Search">
					</form>
				</div>
			</div>

			<div class="d-flex justify-content-end justify-content-md-start">
				<a href="javascript:void(0)" onclick="resetFilters()" class="flex-c-m stext-107 cl6 size-301 bor7 p-lr-15 hov-tag1 trans-04 m-r-5 m-b-5">Reset</a>
			</div>

			<div class="panel-filter w-full p-t-10">
				<div class="wrap-filter flex-w bg6 w-full p-lr-40 p-t-27 p-lr-15-sm">
					<div class="filter-col1 p-r-15 p-b-27">
						<div class="mtext-102 cl2 p-b-15">Category</div>
						<ul>
							<% for(let i=0; i<category.length; i++) { %>
							<li class="p-b-6">
								<a href="javascript:void(0)" onclick="updateFilter('category', '<%= category[i]._id %>')" class="filter-link stext-106 trans-04">
									<%= category[i].name %>
								</a>
							</li>
							<% } %>
						</ul>
					</div>

					<div class="filter-col2 p-r-15 p-b-27">
						<div class="mtext-102 cl2 p-b-15">Price</div>
						<ul>
							<li class="p-b-6">
								<a href="javascript:void(0)" onclick="updateFilter('sort', 'lowToHigh')" class="filter-link stext-106 trans-04">Low to High</a>
							</li>
							<li class="p-b-6">
								<a href="javascript:void(0)" onclick="updateFilter('sort', 'highToLow')" class="filter-link stext-106 trans-04">High to Low</a>
							</li>
						</ul>
					</div>

					<div class="filter-col3 p-r-15 p-b-27">
						<div class="mtext-102 cl2 p-b-15">Alphabet</div>
						<ul>
							<li class="p-b-6">
								<a href="javascript:void(0)" onclick="updateFilter('sort', 'atoz')" class="filter-link stext-106 trans-04">A to Z</a>
							</li>
							<li class="p-b-6">
								<a href="javascript:void(0)" onclick="updateFilter('sort', 'ztoa')" class="filter-link stext-106 trans-04">Z to A</a>
							</li>
						</ul>
					</div>

					<div class="filter-col4 p-b-27">
						<div class="mtext-102 cl2 p-b-15">Brands</div>
						<div class="flex-w p-t-4 m-r--5">
							<% for(let i=0; i<brand.length; i++) { %>
							<a href="javascript:void(0)" onclick="updateFilter('brand', '<%= brand[i].brandName %>')" class="flex-c-m stext-107 cl6 size-301 bor7 p-lr-15 hov-tag1 trans-04 m-r-5 m-b-5">
								<%= brand[i].brandName %>
							</a>
							<% } %>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="row isotope-grid" id="productGrid">
			<% for (let i = 0; i < products.length; i++) { %>
			<div class="col-sm-6 col-md-4 col-lg-3 p-b-35 isotope-item women">
				<div class="block2">
					<div class="block2-pic hov-img0">
						<img src="/Uploads/re-image/<%= products[i].productImage[0] %>" alt="<%= products[i].productName %>">
						<a href="/productDetails?id=<%= products[i]._id %>" class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04">Quick View</a>
					</div>
					<div class="block2-txt flex-w flex-t p-t-14">
						<div class="block2-txt-child1 flex-col-l">
							<a href="/productDetails?id=<%= products[i]._id %>" class="stext-104 cl4 hov-cl1 trans-04 js-name-b2 p-b-6">
								<%= products[i].productName %>
							</a>
							<span class="stext-105 cl3">
								₹<%= products[i].salePrice.toLocaleString('en-IN') %> <strike>₹<%= products[i].regularPrice.toLocaleString('en-IN') %></strike>
							</span>
						</div>
						<div class="block2-txt-child2 flex-r p-t-3">
							<a href="/addToWishlist?id=<%= products[i]._id %>" class="btn-addwish-b2 dis-block pos-relative js-addwish-b2">
								<img class="icon-heart1 dis-block trans-04" src="images/icons/icon-heart-01.png" alt="ICON">
								<img class="icon-heart2 dis-block trans-04 ab-t-l" src="images/icons/icon-heart-02.png" alt="ICON">
							</a>
						</div>
					</div>
				</div>
			</div>
			<% } %>
		</div>

		<div class="pagination" id="pagination">
			<% if (currentPage > 1) { %>
			<a class="btn" href="javascript:void(0)" onclick="updateFilter('page', '<%= currentPage - 1 %>')">Prev</a>
			<% } %>
			<% for (let i = 1; i <= totalPages; i++) { %>
			<a class="btn <%= currentPage === i ? 'active' : '' %>" href="javascript:void(0)" onclick="updateFilter('page', '<%= i %>')"><%= i %></a>
			<% } %>
			<% if (currentPage < totalPages) { %>
			<a class="btn" href="javascript:void(0)" onclick="updateFilter('page', '<%= currentPage + 1 %>')">Next</a>
			<% } %>
		</div>
	</div>
</div>

<script>
function updateFilter(param, value) {
	const url = new URL(window.location.href);
	const searchParams = new URLSearchParams(url.search);

	// Reset page to 1 when changing filters (except when changing page)
	if (param !== 'page') {
		searchParams.set('page', '1');
	}

	// Update the specified parameter
	if (value) {
		searchParams.set(param, value);
	} else {
		searchParams.delete(param);
	}

	// Update URL without reloading
	history.pushState({}, '', `${url.pathname}?${searchParams.toString()}`);

	// Fetch filtered products
	fetchFilteredProducts(searchParams);
}

function resetFilters() {
	const url = new URL(window.location.href);
	const searchParams = new URLSearchParams();
	fetchFilteredProducts(searchParams);
	history.pushState({}, '', '/shop');
}

document.getElementById('searchForm').addEventListener('submit', async (event) => {
	event.preventDefault();
	const query = document.querySelector('.search-input').value.trim();
	const url = new URL(window.location.href);
	const searchParams = new URLSearchParams(url.search);

	// Reset page to 1 on new search
	searchParams.set('page', '1');
	if (query) {
		searchParams.set('query', query);
	} else {
		searchParams.delete('query');
	}

	// Update URL without reloading
	history.pushState({}, '', `${url.pathname}?${searchParams.toString()}`);

	// Fetch filtered products
	fetchFilteredProducts(searchParams);
});

async function fetchFilteredProducts(searchParams) {
	try {
		const response = await fetch(`/filter?${searchParams.toString()}`, {
			method: 'GET',
			headers: { 'Content-Type': 'application/json' }
		});
		const data = await response.json();

		if (data.success) {
			updateProductGrid(data.products);
			updatePagination(data.currentPage, data.totalPages, data.sort);
		} else {
			console.error('Error fetching products:', data.message);
			alert('Failed to load products: ' + data.message);
		}
	} catch (error) {
		console.error('Error fetching products:', error);
		alert('Error fetching products. Please try again.');
	}
}

function updateProductGrid(products) {
	const productGrid = document.getElementById('productGrid');
	if (products.length === 0) {
		productGrid.innerHTML = '<p>No products found.</p>';
		return;
	}

	productGrid.innerHTML = products.map(product => `
		<div class="col-sm-6 col-md-4 col-lg-3 p-b-35 isotope-item women">
			<div class="block2">
				<div class="block2-pic hov-img0">
					<img src="/Uploads/re-image/${product.productImage[0]}" alt="${product.productName}">
					<a href="/productDetails?id=${product._id}" class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04">Quick View</a>
				</div>
				<div class="block2-txt flex-w flex-t p-t-14">
					<div class="block2-txt-child1 flex-col-l">
						<a href="/productDetails?id=${product._id}" class="stext-104 cl4 hov-cl1 trans-04 js-name-b2 p-b-6">
							${product.productName}
						</a>
						<span class="stext-105 cl3">
							₹${product.salePrice.toLocaleString('en-IN')} <strike>₹${product.regularPrice.toLocaleString('en-IN')}</strike>
						</span>
					</div>
					<div class="block2-txt-child2 flex-r p-t-3">
						<a href="/addToWishlist?id=${product._id}" class="btn-addwish-b2 dis-block pos-relative js-addwish-b2">
							<img class="icon-heart1 dis-block trans-04" src="images/icons/icon-heart-01.png" alt="ICON">
							<img class="icon-heart2 dis-block trans-04 ab-t-l" src="images/icons/icon-heart-02.png" alt="ICON">
						</a>
					</div>
				</div>
			</div>
		</div>
	`).join('');
}

function updatePagination(currentPage, totalPages, sort) {
	const pagination = document.getElementById('pagination');
	let paginationHTML = '';

	if (currentPage > 1) {
		paginationHTML += `<a class="btn" href="javascript:void(0)" onclick="updateFilter('page', ${currentPage - 1})">Prev</a>`;
	}

	for (let i = 1; i <= totalPages; i++) {
		paginationHTML += `<a class="btn ${currentPage === i ? 'active' : ''}" href="javascript:void(0)" onclick="updateFilter('page', ${i})">${i}</a>`;
	}

	if (currentPage < totalPages) {
		paginationHTML += `<a class="btn" href="javascript:void(0)" onclick="updateFilter('page', ${currentPage + 1})">Next</a>`;
	}

	pagination.innerHTML = paginationHTML;
}
</script>

<%- include('../partials/user/footer'); %>


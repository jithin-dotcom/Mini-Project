
<%- include("../../views/partials/admin/header") %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>
  .form-select-loading {
    pointer-events: none;
    opacity: 0.7;
    background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="none" stroke="%23007bff" stroke-width="2"><animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite"/></circle></svg>') no-repeat right 0.75rem center/16px 16px;
  }
</style>
<div class="container mt-5">
  <div class="row">
    <div class="col-12">
      <h1 class="text-center mb-4" style="color: #333;"><%= pageTitle %></h1>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-12">
      <form action="/admin/orders" method="GET" class="d-flex flex-wrap gap-2">
      </form>
    </div>
  </div>

  <div class="row">
    <div class="col-12 table-responsive">
      <table class="table table-bordered table-hover" style="background-color: #fff; border-radius: 10px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);">
        <thead style="background-color: #007bff; color: #fff;">
          <tr>
            <th>Order ID</th>
            <th>Customer Name</th>
            <th>Date</th>
            <th>Total</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="orderTableBody">
          <% orders.forEach(order => { %>
          <tr>
            <td><%= order.id %></td>
            <td><%= order.customer %></td>
            <td><%= order.date %></td>
            <td>₹<%= order.total %></td>
            <td>
              <select name="status" class="form-select order-status-select" data-order-id="<%= order.id %>" <%= ['Returned', 'Cancelled'].includes(order.status) ? 'disabled' : '' %> onchange="updateOrderStatus(this)">
                <option value="<%= order.status %>" selected><%= order.status %></option>
                <% if (order.status === 'Pending') { %>
                  <option value="Shipped">Shipped</option>
                  <option value="Cancelled">Cancelled</option>
                <% } else if (order.status === 'Shipped') { %>
                  <option value="Delivered">Delivered</option>
                  <option value="Cancelled">Cancelled</option>
                <% } else if (order.status === 'Delivered') { %>
                  <option value="Returned">Returned</option>
                <% } %>
              </select>
            </td>
            <td>
              <a href="/admin/seeOrder/<%= order.id %>">
                <button class="btn btn-success btn-sm">View</button>
              </a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="row mt-4">
    <div class="col-12 text-center">
      <div class="pagination d-flex flex-wrap justify-content-center align-items-center gap-2" id="pagination">
        <% if (currentPage > 1) { %>
          <a href="#" data-page="<%= currentPage - 1 %>" class="btn btn-outline-primary btn-sm px-3">&laquo; Previous</a>
        <% } else { %>
          <a href="#" class="btn btn-outline-primary btn-sm px-3 disabled">&laquo; Previous</a>
        <% } %>
        <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="#" data-page="<%= i %>" class="btn btn-sm <%= currentPage === i ? 'btn-primary' : 'btn-outline-primary' %>">
            <%= i %>
          </a>
        <% } %>
        <% if (currentPage < totalPages) { %>
          <a href="#" data-page="<%= currentPage + 1 %>" class="btn btn-outline-primary btn-sm px-3">Next &raquo;</a>
        <% } else { %>
          <a href="#" class="btn btn-outline-primary btn-sm px-3 disabled">Next &raquo;</a>
        <% } %>
      </div>
    </div>
  </div>


</div>

<script>
async function updateOrderStatus(selectElement) {
  const orderId = selectElement.dataset.orderId;
  const newStatus = selectElement.value;
 
  selectElement.classList.add('form-select-loading');
  selectElement.disabled = true;

  try {
    const response = await fetch(`/admin/orders/${orderId}/status`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: newStatus })
    });
    const data = await response.json();
   
    if (data.status) {
      Swal.fire({
        icon: 'success',
        title: 'Status Updated',
        text: data.message,
      }).then(() => {
        loadOrders(getCurrentPage());
      });
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: data.message || 'Failed to update order status.',
      });
      selectElement.value = data.currentStatus || selectElement.querySelector('option[selected]').value;
    }
  } catch (error) {
    console.error('Error updating order status:', error);
    Swal.fire({
      icon: 'error',
      title: 'Error',
      text: `Failed to update order status: ${error.message}`,
    });
    selectElement.value = selectElement.querySelector('option[selected]').value;
  } finally {
    selectElement.classList.remove('form-select-loading');
    selectElement.disabled = ['Returned', 'Cancelled'].includes(newStatus);
  }
}

async function loadOrders(page = 1) {
  console.log('loadOrders called with page:', page); // Debug
  try {
    const response = await fetch(`/admin/orders/data?page=${page}`, {
      method: 'GET',
      headers: { 'Content-Type': 'application/json' }
    });
    const data = await response.json();
    console.log('loadOrders response:', data); // Debug
    if (data.status) {
      const tbody = document.getElementById('orderTableBody');
      tbody.innerHTML = data.orders.map(order => `
        <tr>
          <td>${order.id}</td>
          <td>${order.customer}</td>
          <td>${order.date}</td>
          <td>₹${order.total}</td>
          <td>
            <select name="status" class="form-select order-status-select" data-order-id="${order.id}" ${['Returned', 'Cancelled'].includes(order.status) ? 'disabled' : ''} onchange="updateOrderStatus(this)">
              <option value="${order.status}" selected>${order.status}</option>
              ${order.status === 'Pending' ? `
                <option value="Shipped">Shipped</option>
                <option value="Cancelled">Cancelled</option>
              ` : order.status === 'Shipped' ? `
                <option value="Delivered">Delivered</option>
                <option value="Cancelled">Cancelled</option>
              ` : order.status === 'Delivered' ? `
                <option value="Returned">Returned</option>
              ` : ''}
            </select>
          </td>
          <td>
            <a href="/admin/seeOrder/${order.id}">
              <button class="btn btn-success btn-sm">View</button>
            </a>
          </td>
        </tr>
      `).join('');

      const pagination = document.getElementById('pagination');
      pagination.innerHTML = '';
      if (data.currentPage > 1) {
        pagination.innerHTML += `<a href="#" data-page="${data.currentPage - 1}" class="btn btn-outline-primary btn-sm px-3">&laquo; Previous</a>`;
      } else {
        pagination.innerHTML += `<a href="#" class="btn btn-outline-primary btn-sm px-3 disabled">&laquo; Previous</a>`;
      }
      for (let i = 1; i <= data.totalPages; i++) {
        pagination.innerHTML += `
          <a href="#" data-page="${i}" class="btn btn-sm ${i === data.currentPage ? 'btn-primary' : 'btn-outline-primary'}">${i}</a>`;
      }
      if (data.currentPage < data.totalPages) {
        pagination.innerHTML += `<a href="#" data-page="${data.currentPage + 1}" class="btn btn-outline-primary btn-sm px-3">Next &raquo;</a>`;
      } else {
        pagination.innerHTML += `<a href="#" class="btn btn-outline-primary btn-sm px-3 disabled">Next &raquo;</a>`;
      }

      attachPaginationListeners();
    } else {
      Swal.fire('Error', data.message || 'Error loading orders', 'error');
    }
  } catch (error) {
    console.error('Error loading orders:', error);
    Swal.fire('Error', `Error loading orders: ${error.message}`, 'error');
  }
}

function getCurrentPage() {
  const activePage = document.querySelector('.pagination a.btn-primary');
  return activePage ? parseInt(activePage.dataset.page) : 1;
}

function attachPaginationListeners() {
  document.querySelectorAll('.pagination a').forEach(link => {
    link.removeEventListener('click', handlePaginationClick);
    link.addEventListener('click', handlePaginationClick);
  });
}

function handlePaginationClick(e) {
  e.preventDefault();
  if (!e.target.classList.contains('disabled')) {
    const page = parseInt(e.target.dataset.page);
    loadOrders(page);
  }
}

document.addEventListener('DOMContentLoaded', () => {
  attachPaginationListeners();
});
</script>
<%- include("../../views/partials/admin/footer") %>


<%- include("../../views/partials/admin/header") %>




<div class="container-fluid">
    <div class="row">
        <div class="col-12 d-flex justify-content-between align-items-center my-3">
            <h2 class="content-title card-title">Customers</h2>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <header class="card-header text-center mb-4">
                <form id="searchForm" class="d-inline">
                    <div class="input-group input-group-sm border border-1 border-grey rounded-pill mx-auto" style="max-width: 100%; width: 500px;">
                        <input type="text" class="form-control border-0 rounded-pill" placeholder="Search customers..." name="search" id="searchInput">
                        <button class="btn btn-primary border-0" type="submit">Search</button>
                    </div>
                </form>
            </header>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <div class="table-responsive">
                <table class="table table-striped text-center">
                    <thead>
                        <tr>
                            <th scope="col"><b>Name</b></th>
                            <th scope="col"><b>Email</b></th>
                            <th scope="col"><b>Phone No</b></th>
                            <th scope="col"><b>Action</b></th>
                        </tr>
                    </thead>
                    <tbody id="customerTableBody">
                        <% for(let i = 0; i < data.length; i++) { %> 
                        <tr>
                            <td><%= data[i].name %></td>
                            <td><%= data[i].email %></td>
                            <td><%= data[i].phone %></td>
                            <td> 
                                <% if(data[i].isBlocked === false) { %>
                                <button class="btn btn-danger btn-sm" onclick="blockCustomer('<%= data[i]._id %>', this)">Block</button>
                                <% } else { %>
                                <button class="btn btn-success btn-sm" onclick="unblockCustomer('<%= data[i]._id %>', this)">Unblock</button> 
                                <% } %>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12 d-flex justify-content-between">
            <button id="resetButton" class="btn btn-secondary btn-sm">Reset</button>
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center" id="pagination">
                    <% for(let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%=(i === currentPage) ? 'active' : '' %>">
                        <a class="page-link" href="#" data-page="<%= i %>"><%= i %></a>
                    </li>
                    <% } %>
                </ul>
            </nav>
        </div>
    </div>
</div>

<script>
    // Block/Unblock functions (unchanged as per your request)
    async function blockCustomer(id, button) {
        try {
            const response = await fetch('/admin/blockCustomer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
            });
            const data = await response.json();
            if (data.success) {
                button.classList.remove('btn-danger');
                button.classList.add('btn-success');
                button.textContent = 'Unblock';
                button.onclick = () => unblockCustomer(id, button);
            } else {
                alert('Error blocking customer: ' + (data.message || 'Unknown error'));
            }
        } catch (error) {
            console.error('Fetch error:', error);
            alert('Error blocking customer');
        }
    }

    async function unblockCustomer(id, button) {
        try {
            const response = await fetch('/admin/unblockCustomer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
            });
            const data = await response.json();
            if (data.success) {
                button.classList.remove('btn-success');
                button.classList.add('btn-danger');
                button.textContent = 'Block';
                button.onclick = () => blockCustomer(id, button);
            } else {
                alert('Error unblocking customer: ' + (data.message || 'Unknown error'));
            }
        } catch (error) {
            console.error('Fetch error:', error);
            alert('Error unblocking customer');
        }
    }

    // Search and Pagination handling
    async function loadCustomers(page = 1, search = '') {
        try {
            const response = await fetch(`/admin/users/data?page=${page}&search=${encodeURIComponent(search)}`, {
                method: 'GET',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();
            if (data.success) {
                // Update table body
                const tbody = document.getElementById('customerTableBody');
                tbody.innerHTML = data.customers.map(customer => `
                    <tr>
                        <td>${customer.name}</td>
                        <td>${customer.email}</td>
                        <td>${customer.phone}</td>
                        <td>
                            ${customer.isBlocked 
                                ? `<button class="btn btn-success btn-sm" onclick="unblockCustomer('${customer._id}', this)">Unblock</button>`
                                : `<button class="btn btn-danger btn-sm" onclick="blockCustomer('${customer._id}', this)">Block</button>`
                            }
                        </td>
                    </tr>
                `).join('');

                // Update pagination
                const pagination = document.getElementById('pagination');
                pagination.innerHTML = '';
                for (let i = 1; i <= data.totalPages; i++) {
                    const li = document.createElement('li');
                    li.className = `page-item ${i === data.currentPage ? 'active' : ''}`;
                    li.innerHTML = `<a class="page-link" href="#" data-page="${i}">${i}</a>`;
                    pagination.appendChild(li);
                }

                // Reattach pagination event listeners
                attachPaginationListeners();
            } else {
                alert('Error loading customers: ' + (data.message || 'Unknown error'));
            }
        } catch (error) {
            console.error('Fetch error:', error);
            alert('Error loading customers');
        }
    }

    function attachPaginationListeners() {
        document.querySelectorAll('.page-link').forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                const page = parseInt(e.target.dataset.page);
                const search = document.getElementById('searchInput').value;
                loadCustomers(page, search);
            });
        });
    }

    // Search form submission
    document.getElementById('searchForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const search = document.getElementById('searchInput').value;
        loadCustomers(1, search);
    });

    // Reset button
    document.getElementById('resetButton').addEventListener('click', (e) => {
        e.preventDefault();
        document.getElementById('searchInput').value = '';
        loadCustomers(1, '');
    });

    // Initial pagination listeners
    attachPaginationListeners();
</script>
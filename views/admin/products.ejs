




<%- include("../../views/partials/admin/header") %>
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css">
    <style>
        .pagination {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }
        .page-link {
            padding: 10px;
            margin: 0 5px;
            text-decoration: none;
            color: #007bff;
        }
        .page-item.active .page-link {
            background-color: #007bff;
            color: white;
            border-radius: 5px;
        }
        .page-link:hover {
            background-color: #0056b3;
            color: white;
        }
        .disabled .page-link {
            color: #ccc;
            pointer-events: none;
        }
        .btn-loading::after {
            content: '';
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid #fff;
            border-radius: 50%;
            border-top-color: transparent;
            animation: spin 1s linear infinite;
            margin-left: 8px;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<div class="content-header">
    <div>
        <h2 class="content-title card-title">Products</h2>
    </div>
</div>
<header class="card-header text-center mb-20">
    <form id="searchForm" method="get" class="d-inline" onsubmit="return handleSearch(event)">
        <div class="input-group input-group-sm border border-1 border-grey rounded-pill" style="width: 500px; margin-left: 230px;">
            <input type="text" class="form-control border-0 rounded-pill" placeholder="Search products or brands" name="search" value="<%= search || '' %>">
            <button class="btn border-0" type="submit">Search</button>
        </div>
        <input type="hidden" id="currentSearch" value="<%= search || '' %>">
    </form>
</header>
<div class="right mt-5">
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col"><b>Product name</b></th>
                <th scope="col"><b>Brand</b></th>
                <th scope="col"><b>Category</b></th>
                <th scope="col"><b>Sale Price</b></th>
                <th scope="col"><b>Offer Price</b></th>
                <th scope="col"><b>Offer</b></th>
                <!-- <th scope="col"><b>Quantity</b></th> -->
                <th scope="col"><b>Action</b></th>
                <th scope="col"><b>Edit</b></th>
            </tr>
        </thead>
        <tbody id="productTableBody">
            <% for(let i = 0; i < data.length; i++) { %>
            <tr>
                <td><%= data[i].productName %></td>
                <td><%= data[i].brand %></td>
                <td><%= data[i].category.name %></td>
                <td><%= data[i].salePrice %></td>
                <td>
                    <% if (data[i].productOffer) { %>
                        <%= data[i].productOffer %>%
                    <% } else { %>
                        0%
                    <% } %>
                </td>
                <td>
                    <% if (data[i].productOffer === 0) { %>
                    <button class="btn btn-info" onclick="addOffer('<%= data[i]._id %>')" style="width: 100px;">
                        Add Offer
                    </button>
                    <% } else { %>
                    <button class="btn btn-info" onclick="removeOffer('<%= data[i]._id %>')" style="width: 100px;">
                        Remove
                    </button>
                    <% } %>
                </td>
                <!-- <td><%= data[i].quantity %></td> -->
                <td>
                    <% if (data[i].isBlocked === false) { %>
                    <button class="btn btn-danger" style="width: 80px;" onclick="blockProduct('<%= data[i]._id %>', this)">
                        Block
                    </button>
                    <% } else { %>
                    <button class="btn btn-success" style="width: 80px;" onclick="unblockProduct('<%= data[i]._id %>', this)">
                        Unblock
                    </button>
                    <% } %>
                </td>
                <td>
                    <button class="btn btn-info" style="width: 80px;">
                        <a href="/admin/editProduct?id=<%= data[i]._id %>" class="text-white" style="text-decoration: none;">Edit</a>
                    </button>
                </td>
            </tr>
            <% } %>
        </tbody>
    </table>
</div>
<form id="resetForm" action="/admin/products/" method="get" class="d-inline">
    <input type="hidden" name="search" value="">
    <button class="btn btn-secondary" type="submit" onclick="resetSearch()" style="margin-left: 60vw;">Reset</button>
</form>
<div class="container mt-3">
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center mb-20" style="margin-right: 200px;" id="pagination">
            <% if (currentPage > 1) { %>
            <li class="page-item"><a class="page-link" href="#" data-page="<%= currentPage - 1 %>">Previous</a></li>
            <% } else { %>
            <li class="page-item disabled"><span class="page-link">Previous</span></li>
            <% } %>
            <% for (let i = 1; i <= totalPages; i++) { %>
            <li class="page-item <%= (i === currentPage) ? 'active' : '' %>">
                <a class="page-link" href="#" data-page="<%= i %>"><%= i %></a>
            </li>
            <% } %>
            <% if (currentPage < totalPages) { %>
            <li class="page-item"><a class="page-link" href="#" data-page="<%= currentPage + 1 %>">Next</a></li>
            <% } else { %>
            <li class="page-item disabled"><span class="page-link">Next</span></li>
            <% } %>
        </ul>
    </nav>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

<script>
async function addOffer(productId) {
    const { value: amount } = await Swal.fire({
        title: 'Offer in percentage',
        input: 'number',
        inputLabel: 'percentage',
        inputPlaceholder: '%'
    });

    if (amount === undefined || amount === null || amount.trim() === '' || isNaN(amount) || amount < 0 || amount > 100) {
        Swal.fire('Invalid Input', 'Please enter a percentage between 0 and 100.', 'error');
        return;
    }

    const button = document.querySelector(`button[onclick="addOffer('${productId}')"]`);
    button.disabled = true;
    button.textContent = 'Adding...';
    button.classList.add('btn-loading');

    try {
        const response = await fetch('/admin/addProductOffer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId, percentage: amount })
        });
        const data = await response.json();
        if (data.status) {
            Swal.fire('Offer added', data.message, 'success').then(() => {
                loadProducts();
            });
        } else {
            Swal.fire('Error', data.message || 'Failed to add offer. Please try again later', 'error');
        }
    } catch (error) {
        Swal.fire('Error', `An unexpected error occurred: ${error.message}`, 'error');
    } finally {
        button.disabled = false;
        button.textContent = 'Add Offer';
        button.classList.remove('btn-loading');
    }
}

async function removeOffer(productId) {
    const button = document.querySelector(`button[onclick="removeOffer('${productId}')"]`);
    try {
        const result = await Swal.fire({
            title: 'Remove offer',
            text: 'Are you sure you want to remove this offer?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, remove it!',
            timer: 5000,
            timerProgressBar: true
        });

        if (result.isConfirmed) {
            button.disabled = true;
            button.textContent = 'Removing...';
            button.classList.add('btn-loading');

            const response = await fetch('/admin/removeProductOffer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId })
            });
            const data = await response.json();
            if (data.status) {
                Swal.fire('Removed!', data.message || 'The offer has been removed', 'success').then(() => {
                    loadProducts();
                });
            } else {
                Swal.fire('Error', data.message || 'Unable to remove the offer. Please try again.', 'error');
            }
        }
    } catch (error) {
        Swal.fire('Error', `An unexpected error occurred: ${error.message}`, 'error');
    } finally {
        button.disabled = false;
        button.textContent = 'Remove';
        button.classList.remove('btn-loading');
    }
}

async function blockProduct(productId, button) {
    try {
        button.disabled = true;
        button.textContent = 'Blocking...';
        button.classList.add('btn-loading');

        const response = await fetch('/admin/blockProduct', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: productId })
        });
        const data = await response.json();
        if (data.status) {
            Swal.fire('Success', 'Product blocked successfully', 'success').then(() => {
                loadProducts();
            });
        } else {
            Swal.fire('Error', data.message || 'Error blocking product', 'error');
        }
    } catch (error) {
        Swal.fire('Error', `Error blocking product: ${error.message}`, 'error');
    } finally {
        button.disabled = false;
        button.textContent = 'Block';
        button.classList.remove('btn-loading');
    }
}

async function unblockProduct(productId, button) {
    try {
        button.disabled = true;
        button.textContent = 'Unblocking...';
        button.classList.add('btn-loading');

        const response = await fetch('/admin/unblockProduct', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: productId })
        });
        const data = await response.json();
        if (data.status) {
            Swal.fire('Success', 'Product unblocked successfully', 'success').then(() => {
                loadProducts();
            });
        } else {
            Swal.fire('Error', data.message || 'Error unblocking product', 'error');
        }
    } catch (error) {
        Swal.fire('Error', `Error unblocking product: ${error.message}`, 'error');
    } finally {
        button.disabled = false;
        button.textContent = 'Unblock';
        button.classList.remove('btn-loading');
    }
}

async function loadProducts(page = 1) {
    try {
        const search = document.getElementById('currentSearch').value;
        const response = await fetch(`/admin/products/data?page=${page}&search=${encodeURIComponent(search)}`, {
            method: 'GET',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        if (data.status) {
            const tbody = document.getElementById('productTableBody');
            tbody.innerHTML = data.products.map(product => `
                <tr>
                    <td>${product.productName}</td>
                    <td>${product.brand}</td>
                    <td>${product.category.name}</td>
                    <td>${product.salePrice}</td>
                    <td>${product.productOffer ? product.productOffer + '%' : '0%'}</td>
                    <td>
                        ${product.productOffer === 0
                            ? `<button class="btn btn-info" onclick="addOffer('${product._id}')" style="width: 100px;">Add Offer</button>`
                            : `<button class="btn btn-info" onclick="removeOffer('${product._id}')" style="width: 100px;">Remove</button>`
                        }
                    </td>
                    <td>${product.quantity}</td>
                    <td>
                        ${product.isBlocked
                            ? `<button class="btn btn-success" style="width: 80px;" onclick="unblockProduct('${product._id}', this)">Unblock</button>`
                            : `<button class="btn btn-danger" style="width: 80px;" onclick="blockProduct('${product._id}', this)">Block</button>`
                        }
                    </td>
                    <td>
                        <button class="btn btn-info" style="width: 80px;">
                            <a href="/admin/editProduct?id=${product._id}" class="text-white" style="text-decoration: none;">Edit</a>
                        </button>
                    </td>
                </tr>
            `).join('');

            const pagination = document.getElementById('pagination');
            pagination.innerHTML = '';
            if (data.currentPage > 1) {
                pagination.innerHTML += `<li class="page-item"><a class="page-link" href="#" data-page="${data.currentPage - 1}">Previous</a></li>`;
            } else {
                pagination.innerHTML += `<li class="page-item disabled"><span class="page-link">Previous</span></li>`;
            }
            for (let i = 1; i <= data.totalPages; i++) {
                pagination.innerHTML += `
                    <li class="page-item ${i === data.currentPage ? 'active' : ''}">
                        <a class="page-link" href="#" data-page="${i}">${i}</a>
                    </li>`;
            }
            if (data.currentPage < data.totalPages) {
                pagination.innerHTML += `<li class="page-item"><a class="page-link" href="#" data-page="${data.currentPage + 1}">Next</a></li>`;
            } else {
                pagination.innerHTML += `<li class="page-item disabled"><span class="page-link">Next</span></li>`;
            }

            attachPaginationListeners();
        } else {
            Swal.fire('Error', data.message || 'Error loading products', 'error');
        }
    } catch (error) {
        Swal.fire('Error', `Error loading products: ${error.message}`, 'error');
    }
}

function attachPaginationListeners() {
    document.querySelectorAll('.pagination a').forEach(link => {
        link.removeEventListener('click', handlePaginationClick);
        link.addEventListener('click', handlePaginationClick);
    });
}

function handlePaginationClick(e) {
    e.preventDefault();
    const page = parseInt(e.target.dataset.page);
    loadProducts(page);
}

function handleSearch(e) {
    e.preventDefault();
    const searchInput = document.querySelector('input[name="search"]').value;
    document.getElementById('currentSearch').value = searchInput;
    loadProducts(1);
}

function resetSearch() {
    document.querySelector('input[name="search"]').value = '';
    document.getElementById('currentSearch').value = '';
    loadProducts(1);
}

document.addEventListener('DOMContentLoaded', () => {
    attachPaginationListeners();
});
</script>

<%- include("../../views/partials/admin/footer") %>

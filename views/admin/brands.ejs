




<%- include("../../views/partials/admin/header") %>
<head>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs/dist/cropper.min.css">
  <style>
    .pagination {
      display: flex;
      justify-content: center;
      margin-top: 20px;
    }

    .page-number {
      padding: 10px;
      margin: 0 5px;
      text-decoration: none;
      color: #007bff;
    }

    .page-number.active {
      background-color: #007bff;
      color: white;
      border-radius: 5px;
    }

    .page-number:hover {
      background-color: #0056b3;
      color: white;
    }

    .prev, .next {
      padding: 10px;
      margin: 0 5px;
      text-decoration: none;
      color: #007bff;
    }

    .disabled {
      color: #ccc;
      pointer-events: none;
    }

    .error-message {
      color: red;
    }

    .image-cropper {
      display: none;
      width: 300px;
      height: 300px;
      margin-bottom: 20px;
    }
  </style>
</head>
<section class="content-main">
  <div class="content-header">
    <div>
      <h2 class="content-title card-title">Brands</h2>
    </div>
  </div>
  <div class="card">
    <div class="card-body">
      <div class="row">
        <div class="col-md-3">
          <form method="post" action="/admin/addBrand" enctype="multipart/form-data" onsubmit="return validateAndSubmit()">
            <div class="mb-4">
              <label for="product_name" class="form-label">Brand Name</label>
              <input
                type="text"
                name="name"
                placeholder="Type here"
                class="form-control"
              />
            </div>
            <label for="product_name" class="form-label">Brand Image</label>
            <div class="input-upload">
              <img id="imgPreview" src="" alt=""/>
              <input class="form-control border" name="image" type="file" id="inputImage" accept="image/*" onchange="handleImageChange(event)"/>
            </div>
            <div class="image-cropper">
              <img id="croppingImage" src="" alt=""/>
            </div>
            <div class="d-grid">
              <button class="btn btn-primary mt-20" type="submit">
                Add Brand
              </button>
            </div>
          </form>
        </div>
        <div class="col-md-7 ml-105">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Brand</th>
                  <th>Logo</th>
                  <th>Status</th>
                  <th>Block/Unblock/Delete</th>
                </tr>
              </thead>
              <tbody id="brandTableBody">
                <% data.forEach((brand, index) => { %>
                <tr>
                  <td class="text-start"><%= brand.brandName %></td>
                  <td class="text-start">
                    <div
                      class="d-flex align-items-center justify-content-center"
                      style="
                        width: 40px;
                        height: 40px;
                        border-radius: 50%;
                        overflow: hidden;
                      "
                    >
                      <img
                        src="/Uploads/re-image/<%= brand.brandImage[0] %>"
                        alt="<%= brand.brandName %>"
                        class="img-fluid rounded-circle"
                        style="width: 100%; height: auto"
                      />
                    </div>
                  </td>
                  <td class="text-start">
                    <% if (brand.isBlocked === true) { %>
                    <span
                      class="badge rounded-pill alert-danger"
                      style="width: 60px"
                      >Blocked</span
                    >
                    <% } else { %>
                    <span
                      class="badge rounded-pill alert-success"
                      style="width: 60px"
                      >Active</span
                    >
                    <% } %>
                  </td>
                  <td class="text-start">
                    <% if (brand.isBlocked === false) { %>
                    <button class="btn btn-danger" style="width: 90px" onclick="blockBrand('<%= brand._id %>', this)">
                      Block
                    </button>
                    <% } else { %>
                    <button class="btn btn-success" style="width: 90px" onclick="unblockBrand('<%= brand._id %>', this)">
                      Unblock
                    </button>
                    <% } %>
                    <button
                      class="btn btn-danger"
                      style="width: 90px"
                      onclick="confirmDelete('<%= brand._id %>', this)"
                    >
                      Delete
                    </button>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
  <button class="btn btn-primary" style="width: 90px" id="resetButton">Reset</button>

  <div class="pagination" id="pagination">
    <% if (currentPage > 1) { %>
    <a href="#" data-page="<%= currentPage - 1 %>" class="prev">Previous</a>
    <% } else { %>
    <span class="prev disabled">Previous</span>
    <% } %>

    <% for (let i = 1; i <= totalPages; i++) { %>
    <% if (i === currentPage) { %>
    <span class="page-number active"><%= i %></span>
    <% } else { %>
    <a href="#" data-page="<%= i %>" class="page-number"><%= i %></a>
    <% } %>
    <% } %>

    <% if (currentPage < totalPages) { %>
    <a href="#" data-page="<%= currentPage + 1 %>" class="next">Next</a>
    <% } else { %>
    <span class="next disabled">Next</span>
    <% } %>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/cropperjs/dist/cropper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  let cropper;
  function handleImageChange(event) {
    const files = event.target.files;
    if (files && files.length > 0) {
      const file = files[0];
      const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
      if (!validTypes.includes(file.type)) {
        Swal.fire({
          icon: 'error',
          title: 'Invalid Image',
          text: 'Please select a valid image (jpg, jpeg, png, webp).',
        });
        event.target.value = '';
        return;
      }
      const imageUrl = URL.createObjectURL(file);

      const image = document.getElementById('croppingImage');
      image.src = imageUrl;

      const imageCropper = document.querySelector('.image-cropper');
      imageCropper.style.display = 'block';

      cropper = new Cropper(image, {
        aspectRatio: 1,
        viewMode: 1,
        guides: true,
        background: false,
        autoCropArea: 1,
        zoomable: true,
      });
    }
  }

  document.getElementById('cropButton')?.addEventListener('click', function () {
    const canvas = cropper.getCroppedCanvas();
    document.getElementById('imgPreview').src = canvas.toDataURL('image/jpeg');
    canvas.toBlob(function (blob) {
      const fileInput = document.getElementById('inputImage');
      const file = new File([blob], fileInput.files[0].name, { type: 'image/jpeg' });

      const dataTransfer = new DataTransfer();
      dataTransfer.items.add(file);
      fileInput.files = dataTransfer.files;
    });
    document.querySelector('.image-cropper').style.display = 'none';
    cropper.destroy();
  });

  function validateAndSubmit() {
    const brandName = document.querySelector('input[name="name"]').value.trim();
    const fileInput = document.getElementById('inputImage');
    const formData = new FormData(document.forms[0]);
    const regex = /^[a-zA-Z\s]+$/;

    if (brandName.trim().length < 3 || brandName.trim().length > 20) {
      Swal.fire({
        icon: 'warning',
        title: 'Validation Error',
        text: 'Brand name should be between 3 and 20 letters long',
      });
      return false;
    }
    if (!regex.test(brandName)) {
      Swal.fire({
        icon: 'warning',
        title: 'Validation Error',
        text: 'Brand name can only contain alphabets and spaces!',
      });
      return false;
    }
    if (!fileInput.files || fileInput.files.length === 0) {
      Swal.fire({
        icon: 'warning',
        title: 'Validation Error',
        text: 'Brand image is required!',
      });
      return false;
    }

    fetch('/admin/addBrand', {
      method: 'POST',
      body: formData,
    })
    .then(response => {
      if (!response.ok) {
        return response.json().then((data) => {
          throw new Error(data.message || 'Something went wrong!');
        });
      }
      return response.json();
    })
    .then(data => {
      Swal.fire({
        icon: 'success',
        title: 'Success!',
        text: data.message,
      }).then(() => {
        // document.forms[0].reset();
        // document.getElementById('imgPreview').src = '';
        document.forms[0].reset();
        document.getElementById('imgPreview').src = '';
        document.getElementById('inputImage').value = '';
        document.querySelector('.image-cropper').style.display = 'none';
        if (cropper) {
          cropper.destroy();
          cropper = null;
        }
        const currentPage = document.querySelector('.page-number.active')?.textContent || 1;
        loadBrands(parseInt(currentPage));
      });
    })
    .catch(error => {
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: error.message || 'An unexpected error occurred!',
      });
    });

    return false;
  }

  function confirmDelete(brandId, button) {
    Swal.fire({
      title: "Are you sure?",
      text: "You won't be able to undo this action!",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#d33",
      cancelButtonColor: "#3085d6",
      confirmButtonText: "Yes, delete it!",
    }).then((result) => {
      if (result.isConfirmed) {
        fetch(`/admin/deleteBrand`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: brandId })
        })
        .then((response) => response.json())
        .then((data) => {
          if (data.status) {
            Swal.fire("Deleted!", data.message, "success").then(() => {
              button.closest('tr').remove();
              // const tbody = document.getElementById('brandTableBody');
              // if (tbody.children.length === 0) {
              //   const currentPage = document.querySelector('.page-number.active')?.textContent || 1;
              //   loadBrands(parseInt(1));
              // }
              const currentPage = document.querySelector('.page-number.active')?.textContent || 1;
              loadBrands(parseInt(currentPage));
            });
          } else {
            Swal.fire("Error", data.message, "error");
          }
        })
        .catch((error) => {
          console.error("Error:", error);
          Swal.fire("Error", "An unexpected error occurred!", "error");
        });
      }
    });
  }

  async function blockBrand(id, button) {
    try {
      button.disabled = true;
      button.textContent = 'Blocking...';
      const response = await fetch('/admin/blockBrand', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id })
      });
      const data = await response.json();
      if (data.status) {
        button.classList.remove('btn-danger');
        button.classList.add('btn-success');
        button.textContent = 'Unblock';
        button.onclick = () => unblockBrand(id, button);
        button.disabled = false;
        const statusCell = button.closest('tr').querySelector('td:nth-child(3) span');
        statusCell.className = 'badge rounded-pill alert-danger';
        statusCell.textContent = 'Blocked';
        Swal.fire('Success', 'Brand blocked successfully', 'success');
      } else {
        Swal.fire('Error', data.message || 'Error blocking brand', 'error');
        button.textContent = 'Block';
        button.disabled = false;
      }
    } catch (error) {
      console.error('Fetch error:', error);
      Swal.fire('Error', 'Error blocking brand', 'error');
      button.textContent = 'Block';
      button.disabled = false;
    }
  }

  async function unblockBrand(id, button) {
    try {
      button.disabled = true;
      button.textContent = 'Unblocking...';
      const response = await fetch('/admin/unBlockBrand', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id })
      });
      const data = await response.json();
      if (data.status) {
        button.classList.remove('btn-success');
        button.classList.add('btn-danger');
        button.textContent = 'Block';
        button.onclick = () => blockBrand(id, button);
        button.disabled = false;
        const statusCell = button.closest('tr').querySelector('td:nth-child(3) span');
        statusCell.className = 'badge rounded-pill alert-success';
        statusCell.textContent = 'Active';
        Swal.fire('Success', 'Brand unblocked successfully', 'success');
      } else {
        Swal.fire('Error', data.message || 'Error unblocking brand', 'error');
        button.textContent = 'Unblock';
        button.disabled = false;
      }
    } catch (error) {
      console.error('Fetch error:', error);
      Swal.fire('Error', 'Error unblocking brand', 'error');
      button.textContent = 'Unblock';
      button.disabled = false;
    }
  }

  async function loadBrands(page = 1) {
    try {
      const response = await fetch(`/admin/brands/data?page=${page}`, {
        method: 'GET',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await response.json();
      if (data.status) {
        const tbody = document.getElementById('brandTableBody');
        tbody.innerHTML = data.brands.reverse().map(brand => `
          <tr>
            <td class="text-start">${brand.brandName}</td>
            <td class="text-start">
              <div
                class="d-flex align-items-center justify-content-center"
                style="width: 40px; height: 40px; border-radius: 50%; overflow: hidden;"
              >
                <img
                  src="/uploads/re-image/${brand.brandImage[0]}"
                  alt="${brand.brandName}"
                  class="img-fluid rounded-circle"
                  style="width: 100%; height: auto"
                />
              </div>
            </td>
            <td class="text-start">
              <span class="badge rounded-pill ${brand.isBlocked ? 'alert-danger' : 'alert-success'}" style="width: 60px">
                ${brand.isBlocked ? 'Blocked' : 'Active'}
              </span>
            </td>
            <td class="text-start">
              ${brand.isBlocked
                ? `<button class="btn btn-success" style="width: 90px" onclick="unblockBrand('${brand._id}', this)">Unblock</button>`
                : `<button class="btn btn-danger" style="width: 90px" onclick="blockBrand('${brand._id}', this)">Block</button>`
              }
              <button class="btn btn-danger" style="width: 90px" onclick="confirmDelete('${brand._id}', this)">Delete</button>
            </td>
          </tr>
        `).join('');

        const pagination = document.getElementById('pagination');
        pagination.innerHTML = '';
        if (data.currentPage > 1) {
          pagination.innerHTML += `<a href="#" data-page="${data.currentPage - 1}" class="prev">Previous</a>`;
        } else {
          pagination.innerHTML += `<span class="prev disabled">Previous</span>`;
        }
        for (let i = 1; i <= data.totalPages; i++) {
          pagination.innerHTML += i === data.currentPage
            ? `<span class="page-number active">${i}</span>`
            : `<a href="#" data-page="${i}" class="page-number">${i}</a>`;
        }
        if (data.currentPage < data.totalPages) {
          pagination.innerHTML += `<a href="#" data-page="${data.currentPage + 1}" class="next">Next</a>`;
        } else {
          pagination.innerHTML += `<span class="next disabled">Next</span>`;
        }

        attachPaginationListeners();
      } else {
        Swal.fire('Error', data.message || 'Error loading brands', 'error');
      }
    } catch (error) {
      console.error('Fetch error:', error);
      Swal.fire('Error', 'Error loading brands', 'error');
    }
  }

  function attachPaginationListeners() {
    document.querySelectorAll('.pagination a').forEach(link => {
      link.removeEventListener('click', handlePaginationClick);
      link.addEventListener('click', handlePaginationClick);
    });
  }

  function handlePaginationClick(e) {
    e.preventDefault();
    const page = parseInt(e.target.dataset.page);
    loadBrands(page);
  }

  document.getElementById('resetButton').addEventListener('click', (e) => {
    e.preventDefault();
    loadBrands(1);
  });

  attachPaginationListeners();
</script>
<%- include("../../views/partials/admin/footer") %>
